        "knora-api:versionArkUrl": {
            "@value": "http://0.0.0.0:3336/ark:/72163/1/0871/=69lw2B_RCGuvrkg1KeiUgf/0TXdy6G4TvuAZAfpPSufVwO.20260813T102949230791283Z",
