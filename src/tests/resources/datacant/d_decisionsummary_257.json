        },
        "knora-api:versionArkUrl": {
            "@value": "http://0.0.0.0:3336/ark:/72163/1/0871/=69lw2B_RCGuvrkg1KeiUgf/vkEZZ6bbQIS4ZlE0Qjhs_wW.20260813T102949230791283Z",
